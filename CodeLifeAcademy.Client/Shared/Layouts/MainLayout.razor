@inherits LayoutComponentBase

<HeaderLayout />

<div class="page" style="display: flex; min-height: 100vh;">
    <NavMenu />

    <main style="flex: 1; padding: 20px;">
        @Body
    </main>
</div>

@code {
    [Inject] private CustomAuthStateProvider AuthStateProvider { get; set; }

    private Timer _refreshTimer;

    protected override void OnInitialized()
    {
        _refreshTimer = new Timer(async _ =>
        {
            await AuthStateProvider.TryRefreshTokenAsync();
        }, null, TimeSpan.FromMinutes(14), TimeSpan.FromMinutes(14));
    }

    public void Dispose()
    {
        _refreshTimer?.Dispose();
    }
}
