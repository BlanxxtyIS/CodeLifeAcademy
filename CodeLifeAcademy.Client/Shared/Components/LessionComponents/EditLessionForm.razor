@inject HttpClient _http

<div class="form-container">
    <p>@_test</p>
    <div class="form">
        <span class="heading">Редактировать урок @_title</span>
        <input placeholder="Наименование" type="text" class="input" @bind-value=_title>
        <textarea placeholder="Содержание HTML" rows="10" cols="30" id="message" name="message" class="textarea" @bind=_content></textarea>
        <input placeholder="TopicID" type="text" class="input" @bind=_topicId>
        <input placeholder="Order" type="text" class="input" @bind=_order>
        <div class="button-container">
            <button class="send-button" @onclick=Send>Изменить</button>
            <button class="reset-button" @onclick=Reset>Сбросить</button>
            <button class="send-button" @onclick=@(async () => Delete())>Удалить</button>
        </div>

    </div>
</div>

@code {
    [Parameter, EditorRequired] 
    public Lession? EditorLesson { get; set; }

    private string _test = string.Empty;

    private string? _title;
    private string? _content;
    private string? _topicId;
    private int _order;

    protected override async Task OnParametersSetAsync()
    {
        if (EditorLesson is null) return;

        _title = EditorLesson.Title;
        _content = EditorLesson.Content;
        _topicId = EditorLesson.TopicId.ToString();
        _order = EditorLesson.Order;
    }

    private async Task Send()
    {
        if (string.IsNullOrWhiteSpace(_title) || string.IsNullOrWhiteSpace(_content)
        || string.IsNullOrWhiteSpace(_topicId))
        {
            _test = "Заполните все поля!";
            return;
        }

        if (!Guid.TryParse(_topicId, out var topicId))
        {
            _test = "TopicId не является корректным GUID!";
            return;
        }

        EditorLesson.Title = _title;
        EditorLesson.Content = _content;
        EditorLesson.TopicId = topicId;
        EditorLesson.Order = _order;

        try
        {
            var response = await _http.PutAsJsonAsync($"lessions/{EditorLesson.Id}", EditorLesson);

            if (response.IsSuccessStatusCode)
            {
                _test = "Урок успешно добавлен!";
                Reset();
            }
            else
            {
                _test = $"Ошибка: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            _test = $"Ошибка при отправке: {ex.Message}";
        }
        StateHasChanged();
    }

    private void Reset()
    {
        if (EditorLesson is null) return;

        _title = EditorLesson.Title;
        _content = EditorLesson.Content;
        _topicId = EditorLesson.TopicId.ToString();
        _order = 0;
        _test = "Изменения отменены";
    }

    private async Task Delete() {
        if (EditorLesson is null) return;

        try {
            var response = await _http.DeleteAsync($"lessions/{EditorLesson.Id}");

            if (response.IsSuccessStatusCode) {
                _test = "Урок успешно удален!";
                Reset();
            }
            else {
                _test = $"Ошибка: {response.StatusCode}";
            }
        } catch (Exception ex) {
            _test = $"Ошибка при отправке : {ex.Message}";
        }
        StateHasChanged();
    }
}