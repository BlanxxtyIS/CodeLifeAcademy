@inject NavigationManager _navManager

<div class="container-topic">
    <div class="lesson-row">
        @foreach (var lession in Lessions)
        {
            <div>
                <button class="button-question" @onclick="() => GoToLession(lession.Id)">
                    @lession.Title
                </button>
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public List<Lession> Lessions { get; set; } = [];

    private void GoToLession(Guid id) {
        _navManager.NavigateTo($"lesson/{id}");
    }
}