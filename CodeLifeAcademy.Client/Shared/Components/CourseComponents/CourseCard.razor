<div>
    <img src="@Course.Image" alt="@Course.Title" />
    <div>
        <h5>@Course.Title</h5>
        <h6>
            <span></span>
        </h6>
        <div>
            <span>
                <span></span>
                @Course.TimeFormatted
            </span>
            <span>
                <span></span>
                @Course.Progress %
            </span>
        </div>
        <button class="button-question" @onclick="@(async () => await OnSelected.InvokeAsync())">
        </button>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public Course Course { get; set; } = default!;

    [Parameter, EditorRequired]
    public EventCallback OnSelected { get; set; }
}