@inject HttpClient _http
@inject NotificationService NotificationService

<div class="form-container">
    <p>@_test</p>
    <div class="form">
        <span class="heading">Редактировать пользователя @_username</span>
        <input placeholder="Username" type="text" class="input" @bind-value=_username>
        <input placeholder="Email" type="text" class="input" @bind-value=_email>

        <p>@string.Join(", ", EditorUser.UserRoles.Select(ur => ur.Role.Name))</p>

        <fieldset>
            <legend>Выбери нужные роли:</legend>
            <div>
                @foreach (var role in Roles)
                {
                    <div>
                        <input type="checkbox"
                        checked="@IsRoleSelected(role.Id)"
                        @onchange="@(e => ToggleRole(role.Id, e.Value))"/>
                        <label>@role.Name</label>
                    </div>
                }
            </div>
        </fieldset>

        <div class="button-container">
            <button class="send-button" @onclick=Send>Изменить</button>
            <button class="reset-button" @onclick=Reset>Сбросить</button>
        </div>

    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public User? EditorUser { get; set; }

    [Parameter, EditorRequired]
    public IEnumerable<Role>? Roles { get; set; }

    private string _test = string.Empty;

    private string? _username;
    private string? _email;
    private IEnumerable<Role>? _roles;
    private HashSet<Guid> _selectedRoleIds = new();
    private bool IsRoleSelected(Guid roleId) => _selectedRoleIds.Contains(roleId);

    protected override void OnInitialized()
    {
        _roles = EditorUser.UserRoles.Select(ur => ur.Role);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (EditorUser is null) return;

        _username = EditorUser.Username;
        _email = EditorUser.Email;
    }

    private void ToggleRole(Guid roleId, object isChecked)
    {
        if ((bool)isChecked)
            _selectedRoleIds.Add(roleId);
        else
            _selectedRoleIds.Remove(roleId);
    }

    private async Task Send()
    {
        if (string.IsNullOrWhiteSpace(_username) || string.IsNullOrWhiteSpace(_email))
        {
            _test = "Заполните все поля!";
            return;
        }

        try
        {
            var updateDto = new UserUpdateDto
                {
                    Username = _username,
                    Email = _email,
                    RoleIds = _selectedRoleIds.ToList()
                };

            var response = await _http.PutAsJsonAsync($"users/{EditorUser.Id}", updateDto);

            if (response.IsSuccessStatusCode)
            {
                _test = "Пользователь успешно обновлен!";
                await NotifyRefresh();
                Reset();
            }
            else
            {
                _test = $"Ошибка: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            _test = $"Ошибка при отправке: {ex.Message}";
        }
        StateHasChanged();
    }

    private void Reset()
    {
        if (EditorUser is null) return;

        _username = EditorUser.Username;
        _email = EditorUser.Email;
        _test = "Изменения отменены";
    }

    private async Task NotifyRefresh()
    {
        await NotificationService.RequestDataRefresh();
    }
}