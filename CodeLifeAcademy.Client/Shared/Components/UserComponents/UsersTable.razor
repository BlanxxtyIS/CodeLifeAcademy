@if (Users is null)
{
    <p>Loading...</p>
}
else
{
    <h3>@Title</h3>

    @if (_showEditUserForm)
    {
        <EditUserForm EditorUser="_currentEditUser" />
    }
    <table>
        <thead>
            <tr>
                <th>Id</th>
                <th>Username</th>
                <th>Email</th>
                <th>UserRoles</th>
                <th>RefreshToken</th>
                <th>CreatedAt</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Users)
            {
                <tr>
                    <td>@user.Id</td>
                    <td>@user.Username</td>
                    <td>@user.Email</td>
                    <td>
                            РОЛИ
                    </td>
                    <td>@user.RefreshToken</td>
                    <td>@user.CreatedAt.ToString()</td>
                    <td>
                        <button @onclick="@(() => EditEntity(user))">Редактировать</button>
                    </td>
                </tr>

            }
        </tbody>
    </table>
}

@code {
    [Parameter]
    public string Title { get; set; } = "";

    [Parameter]
    public IEnumerable<User>? Users { get; set; }

    [Parameter]
    public IEnumerable<UserRole>? UserRoles { get; set; }

    private bool _showEditUserForm;
    private User? _currentEditUser;

    private void EditEntity(User entity)
    {
        _currentEditUser = entity;
        _showEditUserForm = !_showEditUserForm;
    }
}
