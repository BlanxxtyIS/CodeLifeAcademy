@page "/lesson/{LessonId:guid}"
@inject HttpClient _http
@inject NavigationManager _navManager

@if (Lesson is null)
{
    <p>Загрузка...</p>
}
else
{
    <div class="lesson-container">
        <h1>@Lesson.Title</h1>
        <div class="lesson-content">@((MarkupString)Lesson.Content)</div>

        <div class="lesson-navigation">
            <button class="btn btn-primary" @onclick="GoToBackLession">
                Назад
            </button>
            <button class="btn btn-primary" @onclick="GoToNextLesson">
                Следующий урок
            </button>
        </div>
    </div>
}

@code {
    [Parameter] public Guid LessonId { get; set; }

    private Lession? Lesson;
    private List<Lession>? Lessons;
    private bool isLoading;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            Lesson = await _http.GetFromJsonAsync<Lession>($"/lessions/{LessonId}");
            if (isLoading)
            {
                Lessons = await _http.GetFromJsonAsync<List<Lession>>($"/lessions");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Ошибка загрузки урока: " + ex.Message);
        }

    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Загружаем список уроков только один раз
            Lessons = await _http.GetFromJsonAsync<List<Lession>>($"/lessions");
        }
        catch (Exception ex)
        {
            Console.WriteLine("Ошибка загрузки списка уроков: " + ex.Message);
        }
        finally
        {
            isLoading = true;
        }
    }

    private void GoToBackLession()
    {
        var prevLessonId = GetPreviousLessonId();

        if (prevLessonId != Guid.Empty) {
            _navManager.NavigateTo($"/lesson/{prevLessonId}");
        }

    }

    private void GoToNextLesson()
    {
        var nextLessionId = GetNextLessonId();

        if (nextLessionId != Guid.Empty) {
            _navManager.NavigateTo($"/lesson/{nextLessionId}");
        }
    }

    private Guid GetPreviousLessonId()
    {
        if (Lessons == null || Lesson == null) return Guid.Empty;

        var currentIndex = Lessons.FindIndex(l => l.Id == LessonId);
        if (currentIndex <= 0) 
        {
            return Guid.Empty;
        }

        return Lessons[currentIndex - 1].Id;
    }

    private Guid GetNextLessonId()
    {
        if (Lessons == null || Lesson == null) return Guid.Empty;

        var currentIndex = Lessons.FindIndex(l => l.Id == LessonId);
        if (currentIndex == -1 || currentIndex >= Lessons.Count - 1)
        {
            return Guid.Empty; // Нет следующего урока
        }

        return Lessons[currentIndex + 1].Id;
    }
}