@page "/"
@inject HttpClient _http
@inject NavigationManager _navManager

<PageTitle>Курсы</PageTitle>

<div class="content">
    <h3>Курсы</h3>

    @if (_errorMessage is not null) {
        <p>@_errorMessage</p>
    } else if (_courses is null) {
        <p>Загрузка страницы</p>
    }

    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px;">
        @if (_courses is not null)
        {
            @foreach (var course in _courses)
            {
                <CourseCard Course="course" OnSelected="() => HandleCourseSelected(course.Id)" />
            }
        } else {
            <p>Курсы не найдены</p>
        }
    </div>
</div>


@code {
    private IEnumerable<Course>? _courses;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _courses = await _http.GetFromJsonAsync<IEnumerable<Course>>("/courses");
        }
        catch (HttpRequestException ex)
        {
            _errorMessage = $"Ошибка при загрузке курсов. Пожалуйста, обратитесь к администратору и попробуйте позже: {ex}";
        }
        catch (Exception ex) {
            _errorMessage = $"Неизвестная ошибка. Обратитесь к администратору: {ex}";
        }
    }

    private void HandleCourseSelected(Guid courseId) =>
        _navManager.NavigateTo($"/topicsPage/{courseId}");
}
