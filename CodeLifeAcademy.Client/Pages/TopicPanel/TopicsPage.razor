@page "/topicsPage"
@inject HttpClient _http
@inject NotificationService NotificationService

<PageTitle>Topics</PageTitle>

<div class="content">
    <h3>IOS [SWIFT] - Разработчик</h3>

    <AuthorizeView>
        <Authorized>
            @if (_topics is null)
            {
                <p>Загрузка тем...</p>
            }
            else if (!_topics.Any())
            {
                <p>Тем пока нет</p>
            }
            else
            {
                @foreach (var topic in _topics)
                {
                    <TopicCard CurrentTopic="@topic" />
                }
            }
        </Authorized>
        <NotAuthorized>
            <p>Ну ка брысь!</p>
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    private IEnumerable<Topic>? _topics;

    protected override async Task OnInitializedAsync() {
        try {
            RefreshData();
            NotificationService.OnDataRefreshRequested += RefreshData;
            await NotificationService.ConnectAsync();
        }
        catch (HttpRequestException ex)
        {
            Console.WriteLine($"Ошибка при загрузке тем курса {ex.Message}");
        }
    }

    private async void RefreshData()
    {
        Console.WriteLine("Обновление данных от SignalR");
        try
        {
            _topics = await _http.GetFromJsonAsync<IEnumerable<Topic>>("/topics");
        } catch {
            _topics = null;
        }
        StateHasChanged();
    }
}
