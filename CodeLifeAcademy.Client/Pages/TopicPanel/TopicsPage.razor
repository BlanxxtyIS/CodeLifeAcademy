@page "/topicsPage/{courseId:guid}"
@inject HttpClient _http
@inject NotificationService NotificationService

<PageTitle>Topics</PageTitle>

<div class="content">
    <h3>IOS [SWIFT] - Разработчик</h3>

    <AuthorizeView>
        <Authorized>
            @if (_topics is null)
            {
                <p>Загрузка тем...</p>
            }
            else if (!_topics.Any())
            {
                <p>Тем пока нет</p>
            }
            else
            {
                @foreach (var topic in _topics)
                {
                    <TopicCard CurrentTopic="@topic" />
                }
            }
        </Authorized>
        <NotAuthorized>
            <p>Поажуйлста авторизуйтесь🔐</p>
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    [Parameter]
    public Guid courseId { get; set; }

    private IEnumerable<Topic>? _topics;
    private string? _courseTitle;

    protected override async Task OnInitializedAsync() {
        try {
            RefreshData();
            NotificationService.OnDataRefreshRequested += RefreshData;
            await NotificationService.ConnectAsync();
        }
        catch (HttpRequestException ex)
        {
            Console.WriteLine($"Ошибка при загрузке тем курса {ex.Message}");
        }
    }

    private async void RefreshData()
    {
        Console.WriteLine("Обновление данных от SignalR");
        try
        {
            _topics = await _http.GetFromJsonAsync<IEnumerable<Topic>>("/topics");
            Console.WriteLine($"МАРААААААААААТ - {_topics.Count()}");
            _topics = _topics?.Where(t => t.CourseId == courseId).ToList();
            Console.WriteLine($"22222МАРААААААТ - {_topics.Count()}");
            _courseTitle = _topics?.FirstOrDefault()?.Course.Title;
        } catch {
            _topics = null;
        }
        StateHasChanged();
    }
}
