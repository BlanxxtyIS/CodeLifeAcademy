@page "/adminPanel"
@inject HttpClient Http
@inject NotificationService NotificationService
@implements IDisposable

@attribute [Authorize(Roles = "Admin")]
<PageTitle>Admin Page</PageTitle>

<div class="content">
    <h1>Админ-панель</h1>
    <p>Здесь редактируем ресурсы: пользователей, курсы, темы и уроки.</p>

    <AuthorizeView>
        <Authorized>
            <UsersTable Title="Users" Users="_users" Roles="_roles" />
            <hr />
            <CourseTable Title="Courses" Courses="_courses" />
            <hr />
            <TopicTable Title="Topics" Topics="_topics" />
            <hr />
            <LessionTable Lessions="_lessions" Title="Lessions" />
        </Authorized>
        <NotAuthorized>
            <p><b>Пшел вон с этой страницы</b></p>
        </NotAuthorized>
    </AuthorizeView>
</div>


@code {

    private List<User>? _users;
    private List<Role>? _roles;
    private List<Course>? _courses;
    private List<Topic>? _topics;
    private List<Lession>? _lessions;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        NotificationService.OnDataRefreshRequested += RefreshData;
        await NotificationService.ConnectAsync();
    }

    private async void RefreshData()
    {
        Console.WriteLine("Обновление данных от SignalR");
        await LoadData();
        StateHasChanged();
    }

    public async Task LoadData()
    {
        _users = await Http.GetFromJsonAsync<List<User>>("/users");
        _roles = await Http.GetFromJsonAsync<List<Role>>("/users/roles");
        _courses = await Http.GetFromJsonAsync<List<Course>>("/courses");
        _topics = await Http.GetFromJsonAsync<List<Topic>>("/topics");
        _lessions = await Http.GetFromJsonAsync<List<Lession>>("/lessions");
    }

    public async void Dispose()
    {
        NotificationService.OnDataRefreshRequested -= RefreshData;
    }
}
