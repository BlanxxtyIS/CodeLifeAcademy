@page "/userPanel"
@inject NotificationService NotificationService

<PageTitle>MyPanel</PageTitle>

<h3>📢 Чат SignalR</h3>

<div>
    <input @bind="user" placeholder="Имя" />
    <input @bind="message" placeholder="Сообщение" />
    <button @onclick="SendMessage">Отправить</button>
</div>

<hr />
<ul>
    @foreach (var msg in messages)
    {
        <li><strong>@msg.User:</strong> @msg.Text</li>
    }
</ul>

@code {
    private string user;
    private string message;
    private List<(string User, string Text)> messages = new();

    protected override async Task OnInitializedAsync()
    {
        NotificationService.OnMessageReceived += (user, msg) =>
        {
            messages.Add((user, msg));
            InvokeAsync(StateHasChanged);
        };

        await NotificationService.ConnectAsync();
    }

    private async Task SendMessage()
    {
        await NotificationService.SendMessageAsync(user, message);
        message = "";
    }
}
